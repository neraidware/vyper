# Build output. build.odin writes target/<mode>/; gate.sh and nix write beside
# it. `target/` rather than the mode dirs, so a new mode needs no entry.
/target
/target/

/vgcore.*
/result

# Local git worktrees. Each is a FULL checkout with its own build output, so
# without this `git add -A` in the primary checkout commits a nested repo
# (build artifacts, its own .git file, and every in-progress change inside it).
/.worktrees/

# Compile-time outputs (nanosvg C TU), produced by flake.nix / CI / local build
/vyper/vendor/nanosvg/*.o
/vyper/vendor/nanosvg/*.obj

# Clay C TU + linked archive, produced by flake.nix / CI / local build from
# the vendored single-header vendor/clay.h (never ship prebuilt clay binaries)
/vyper/vendor/clay.o
/vyper/clay-odin/*/clay.a
/vyper/clay-odin/*/clay.lib
/vyper/clay-odin/*/clay.o

# gate.sh keyed_export scratch: synthetic source and A/B encodes, regenerated
# per run and never inputs.
__pycache__/
