# Build output
/vyper
# swsbench binary from `./scripts/gate.sh bench`
/bin_swsbench

# Render / probe output artifacts
/render.mp4

# Valgrind core dumps. A crashed run leaves one in the cwd and it is ~650MB;
# `git add -A` will otherwise commit it alongside the change that caused the
# crash. The log under target/valgrind/ is the artifact worth keeping.
/vgcore.*

# nix build result symlink
/result

# Compile-time outputs (nanosvg C TU), produced by flake.nix / CI / local build
/vendor/nanosvg/*.o
/vendor/nanosvg/*.obj

# Clay C TU + linked archive, produced by flake.nix / CI / local build from
# the vendored single-header vendor/clay.h (never ship prebuilt clay binaries)
/vendor/clay.o
/clay-odin/*/clay.a
/clay-odin/*/clay.lib
/clay-odin/*/clay.o

# gate.sh keyed_export scratch: synthetic source and A/B encodes, regenerated
# per run and never inputs.
target/
